# 2025 R1
SetScriptVersion(Version="25.1.122")
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system1 = template1.CreateSystem()
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath=GetAbsoluteUserPathName("UCI Stuff/BME 60D/Saccular_Anuerysms.STL"))
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
geometry1.SetFile(FilePath=GetAbsoluteUserPathName("UCI Stuff/BME 60D/Saccular_Anuerysms_Fine.STL"))
modelComponent1.Update(AllDependencies=True)
model1.Edit()
model1.Exit()
model1.Edit()
geometry1.SetFile(FilePath=GetAbsoluteUserPathName("UCI Stuff/BME 60D/Saccular_Anuerysms_course.STL"))
model1.Exit()
modelComponent1.Update(AllDependencies=True)
model1.Edit()
geometry1.SetFile(FilePath=GetAbsoluteUserPathName("UCI Stuff/BME 60D/Saccular_Anuerysms.STL"))
modelComponent1.Update(AllDependencies=True)
model1.Edit()
geometry1.SetFile(FilePath=GetAbsoluteUserPathName("UCI Stuff/BME 60D/Saccular_Anuerysms.x_t"))
modelComponent1.Update(AllDependencies=True)
model1.Edit()
model1.Exit()
model1.Edit()
model1.Exit()
geometry1.Edit(IsDiscoveryGeometry=True)
modelComponent1.Update(AllDependencies=True)
model1.Edit()
model1.Exit()
geometry1.SetFile(FilePath=GetAbsoluteUserPathName("UCI Stuff/BME 60D/Saccular_Anuerysms.STL"))
modelComponent1.Update(AllDependencies=True)
model1.Edit()
geometry1.SetFile(FilePath=GetAbsoluteUserPathName("UCI Stuff/BME 60D/Saccular_Anuerysms.STEP"))
modelComponent1.Update(AllDependencies=True)
model1.Edit()
Save(Overwrite=True)
Save(Overwrite=True)
Save(Overwrite=True)
